# Copy this to backend.hcl (gitignored) and fill in your values.
# The state bucket must exist before running terraform init.
# See README for bootstrap instructions.

bucket         = "your-terraform-state-bucket-name"
key            = "disney-planner/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "your-terraform-state-lock-table"
encrypt        = true
